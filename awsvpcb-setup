#!/bin/bash
# This script prepares a professor"s AWS environment to support a course using AWSVPCB
#
# VERSION 2 - only the DIAGLOG related resources are created:
#             S3 bucket, DIAGLOG-UPLOAD and DIAGLOG-TRIGGER Lambda functions,
#             their Function URL / permissions / log groups, the SNS topic and
#             the IAM role and policy they use.
#
#             Revised 2026-09-03 - distro independent prerequisite install, the
#             DIAGLOG-UPLOAD resource policy is written to the log, and a failing
#             end to end test now repairs an ineffective public invoke statement.
#
# Creating Log
echo $(date) "Starting script awsvpcb-setup (v2)" >> awsvpcb-setup.log

FAILED_UPLOAD_KEY="UNKNOWN"

# Uploads the setup log to the central support bucket and exits (used on fatal errors)
bail_out () {
   echo $(date) "Uploading awsvpcb-setup.log for review, if needed..." | tee -a awsvpcb-setup.log
   wget -q "https://juxhn343davm6xxnhibsvalsje0rwnxx.lambda-url.us-east-2.on.aws/?filename=professor_setup_logs%2F$FAILED_UPLOAD_KEY.awsvpcb-setup.log" -O presignedURL
   URL=`cat presignedURL | sed 's/^.//' | sed 's/.$//'`
   if [ "$URL" != "" ]; then
      curl --silent -X PUT -H "Content-type : multipart/form-data" --data-binary "@awsvpcb-setup.log" $URL
   fi
   rm -f presignedURL
   exit 1
}


# Verify whether the AWS CLI is installed or not
# The professors are not all on Ubuntu - openSUSE (zypper), Amazon Linux / Fedora
# (dnf) and CentOS (yum) are all in use - so pick whichever package manager exists
# and only install what is actually missing.
echo $(date) "Checking prerequisites" | tee -a awsvpcb-setup.log
PKG_MISSING=""
for CMD in unzip zip curl wget; do
   command -v $CMD > /dev/null 2>&1
   if [ $? -ne 0 ]; then PKG_MISSING="$PKG_MISSING $CMD"; fi
done
if [ "$PKG_MISSING" == "" ]; then
   echo $(date) "All prerequisites (unzip zip curl wget) are already installed - moving on..." | tee -a awsvpcb-setup.log
else
   echo $(date) "Installing missing prerequisites:$PKG_MISSING" | tee -a awsvpcb-setup.log
   if command -v apt-get > /dev/null 2>&1; then
      sudo apt-get update >> awsvpcb-setup.log 2>&1
      sudo apt-get install -y $PKG_MISSING >> awsvpcb-setup.log 2>&1
   elif command -v zypper > /dev/null 2>&1; then
      sudo zypper --non-interactive refresh >> awsvpcb-setup.log 2>&1
      sudo zypper --non-interactive install $PKG_MISSING >> awsvpcb-setup.log 2>&1
   elif command -v dnf > /dev/null 2>&1; then
      sudo dnf install -y $PKG_MISSING >> awsvpcb-setup.log 2>&1
   elif command -v yum > /dev/null 2>&1; then
      sudo yum install -y $PKG_MISSING >> awsvpcb-setup.log 2>&1
   else
      echo $(date) "WARNING - no supported package manager found (apt-get, zypper, dnf, yum)." | tee -a awsvpcb-setup.log
      echo $(date) "          Please install these yourself before re-running:$PKG_MISSING" | tee -a awsvpcb-setup.log
   fi
   for CMD in $PKG_MISSING; do
      command -v $CMD > /dev/null 2>&1
      if [ $? -ne 0 ]; then
         echo $(date) "WARNING - $CMD is still not installed and the setup needs it." | tee -a awsvpcb-setup.log
      fi
   done
fi
aws --version > awscliout.temp 2> awsclierror.temp
echo $(date) "Standard out of aws --version is as follows:" >> awsvpcb-setup.log
cat awscliout.temp >> awsvpcb-setup.log
echo $(date) "Standard error of aws --version is as follows:" >> awsvpcb-setup.log
cat awsclierror.temp >> awsvpcb-setup.log
VERSION1_CHK=`grep "aws-cli/1" awscliout.temp | wc -l`
if [ -s awscliout.temp -a $VERSION1_CHK -eq 0 ]; then
   echo $(date) "Found AWS CLI V2 already installed - skipping AWS Installation Steps" | tee -a awsvpcb-setup.log
else
   if [ $VERSION1_CHK -eq 1 ]; then
      echo $(date) "Found AWS CLI V1 installed, but need V2, so installing AWS CLI V2 alongside V1..." | tee -a awsvpcb-setup.log
   fi
   echo $(date) "Downloading the AWS CLI v2 installation package" | tee -a awsvpcb-setup.log
   curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" >> awsvpcb-setup.log
   echo $(date) "Unzipping the installer" | tee -a awsvpcb-setup.log
   unzip awscliv2.zip >> awsvpcb-setup.log
   echo $(date) "Running the install program" | tee -a awsvpcb-setup.log
   sudo ./aws/install >> awsvpcb-setup.log
   echo $(date) "Verifying the installation" | tee -a awsvpcb-setup.log
   aws --version > awscli.chk 2> awschk.e
   echo $(date) "Standard out of aws --version is as follows:" >> awsvpcb-setup.log
   cat awscli.chk >> awsvpcb-setup.log
   echo $(date) "Standard error of aws --version is as follows:" >> awsvpcb-setup.log
   cat awschk.e >> awsvpcb-setup.log
   if [ -s awscli.chk ]; then
      echo $(date) "Installation successful" | tee -a awsvpcb-setup.log
   else
      echo $(date) "Problem with the installation - please check previous messages and contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
   echo $(date) "Cleaning up installation files" | tee -a awsvpcb-setup.log
   rm -rf awscliv2.zip aws
   rm -f awscli.chk awschk.e
fi
rm -f awscli*.temp


# Create credentials, if needed
aws sts get-caller-identity > UID_good.temp 2> UID_bad.temp
echo $(date) "Standard out of aws sts get-caller-identity is as follows:" >> awsvpcb-setup.log
cat  UID_good.temp >> awsvpcb-setup.log
echo $(date) "Standard error of aws sts get-caller-identity is as follows:" >> awsvpcb-setup.log
cat UID_bad.temp >> awsvpcb-setup.log
if [ -s UID_bad.temp ]; then
   echo $(date) "User not logged in, initiating AWS Login" | tee -a awsvpcb-setup.log
   aws login | tee -a awsvpcb-setup.log
   aws sts get-caller-identity > UID_good.temp 2> UID_bad.temp
   echo $(date) "Standard out of aws sts get-caller-identity is as follows:" >> awsvpcb-setup.log
   cat  UID_good.temp >> awsvpcb-setup.log
   echo $(date) "Standard error of aws sts get-caller-identity is as follows:" >> awsvpcb-setup.log
   cat UID_bad.temp >> awsvpcb-setup.log
   if [ -s UID_bad.temp ]; then
      echo $(date) "User failed to login, ending script - please check previous messages and contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
fi

# Parsed with --query instead of grep/cut so it also works when the professor's
# CLI is configured with "output = text" or "output = yaml"
AWS_UID=`aws sts get-caller-identity --query Account --output text 2>> awsvpcb-setup.log`
if [ "$AWS_UID" == "" ]; then
   echo $(date) "Unable to determine the AWS Account number - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
   bail_out
fi
FAILED_UPLOAD_KEY="$AWS_UID"
echo $(date) "The account logged in is $AWS_UID" | tee -a awsvpcb-setup.log
rm -f UID_*.temp

BUCKET=awsvpcb-diag-files-$AWS_UID


# Determine the region to build everything in.  The bucket, both Lambda functions,
# the SNS topic and the log groups MUST all be in the same region or the S3 event
# notification will not attach and the presigned URLs will not sign correctly.
aws s3api head-bucket --bucket $BUCKET > /dev/null 2>&1
if [ $? -eq 0 ]; then
   REGION=`aws s3api get-bucket-location --bucket $BUCKET --query LocationConstraint --output text 2>> awsvpcb-setup.log`
   if [ "$REGION" == "None" -o "$REGION" == "null" -o "$REGION" == "" ]; then
      REGION=us-east-1
   fi
   echo $(date) "S3 bucket $BUCKET already exists in $REGION - moving on..." | tee -a awsvpcb-setup.log
else
   REGION=`aws configure get region 2>/dev/null`
   if [ "$REGION" == "" ]; then REGION=$AWS_DEFAULT_REGION; fi
   if [ "$REGION" == "" ]; then REGION=us-east-1; fi
   echo $(date) "Creating S3 Bucket $BUCKET in $REGION" | tee -a awsvpcb-setup.log
   if [ "$REGION" == "us-east-1" ]; then
      aws s3api create-bucket --bucket $BUCKET --region us-east-1 >> awsvpcb-setup.log 2>&1
   else
      aws s3api create-bucket --bucket $BUCKET --region $REGION --create-bucket-configuration LocationConstraint=$REGION >> awsvpcb-setup.log 2>&1
   fi
   aws s3api head-bucket --bucket $BUCKET > /dev/null 2>&1
   if [ $? -ne 0 ]; then
      echo $(date) "Unable to create the S3 bucket $BUCKET - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
fi
echo $(date) "All AWSVPCB DIAGLOG resources will be created in region $REGION" | tee -a awsvpcb-setup.log


# Look in S3 Bucket for previous professor settings
rm -f S3settings.temp
aws s3api get-object --bucket $BUCKET --key SetupSettings S3settings.temp >> awsvpcb-setup.log 2>&1
if [ -s S3settings.temp ]; then
   echo $(date) "Found previous settings in S3 Bucket, loading them..." | tee -a awsvpcb-setup.log
   chmod 755 S3settings.temp
   . ./S3settings.temp
else
   echo $(date) "No previous settings found in S3 Bucket, moving on..." | tee -a awsvpcb-setup.log
fi
rm -f S3settings.temp


# Show previous information, if any and get information from the professor
if [ "$AWSVPCB_SUPPORT" == "" ]; then
   AWSVPCB_SUPPORT=Y
fi
if [ "$AWSVPCB_REGISTRY_ADD" == "" ]; then
   AWSVPCB_REGISTRY_ADD=Y
fi
echo
while true; do
   echo "PLEASE FILL OUT THE BELOW FIELDS.  PREVIOUS SETTINGS (if any) ARE SHOWN AND DEFAULT SO YOU CAN HIT ENTER TO KEEP:"
   while true; do
      read -p "PLEASE PROVIDE THE NAME OF YOUR INSTITUTION [$AWSVPCB_INSTITUTION]: " institution
      if [ "$institution" != "" ]; then
         AWSVPCB_INSTITUTION=$institution
         break
      elif [ "$AWSVPCB_INSTITUTION" == "" ]; then
         echo "NEED TO PROVIDE THE NAME OF YOUR INSTITUTION FOR THE STUDENTS TO SEE".
      else
         break
      fi
   done
   while true; do
      read -p "WHAT NAME TO PRESENT TO STUDENTS [$AWSVPCB_PROFESSOR]: " prof
      if [ "$prof" != "" ]; then
         AWSVPCB_PROFESSOR=$prof
         break
      elif [ "$AWSVPCB_PROFESSOR" == "" ]; then
         echo "NEED TO PROVIDE A NAME FOR THE STUDENTS TO CHOOSE".
      else
         break
      fi
   done
   while true; do
      read -p "EMAIL ADDRESS TO SEND DIAGLOG ALERTS TO [$AWSVPCB_EMAIL]: " email
      if [ "$email" != "" ]; then
         AWSVPCB_EMAIL=$email
         break
      elif [ "$AWSVPCB_EMAIL" == "" ]; then
         echo "NEED TO PROVIDE AN EMAIL TO SEND ALERTS TO".
      else
         break
      fi
   done
   while true; do
      read -p "LIST OUT COURSE NAMES SPACE DELIMITED (courses cannot include space) [$AWSVPCB_COURSES]: " courses
      if [ "$courses" != "" ]; then
         AWSVPCB_COURSES=$courses
         break
      elif [ "$AWSVPCB_COURSES" == "" ]; then
         echo "NEED TO PROVIDE AT LEAST ONE COURSE".
      else
         break
      fi
   done
   while true; do
      read -p "DO YOU WANT STUDENT DIAGLOGS SENT TO SUPPORT AS WELL [$AWSVPCB_SUPPORT]: " support
      if [ "$support" == "" ]; then break; fi
      case "$support" in
         y|Y) AWSVPCB_SUPPORT=Y; break;;
         n|N) AWSVPCB_SUPPORT=N; break;;
         *)   echo "PLEASE ANSWER Y OR N.";;
      esac
   done
   while true; do
      read -p "DO YOU WANT YOUR vpcb-config FILE ADDED TO REGISTRY FOR STUDENT SELECTION [$AWSVPCB_REGISTRY_ADD]: " registry
      if [ "$registry" == "" ]; then break; fi
      case "$registry" in
         y|Y) AWSVPCB_REGISTRY_ADD=Y; break;;
         n|N) AWSVPCB_REGISTRY_ADD=N; break;;
         *)   echo "PLEASE ANSWER Y OR N.";;
      esac
   done
   echo
   echo "PLEASE VERIFY YOUR ANSWERS BELOW:"
   echo "AWSVPCB_INSTITUTION=$AWSVPCB_INSTITUTION"
   echo "AWSVPCB_PROFESSOR=$AWSVPCB_PROFESSOR"
   echo "AWSVPCB_EMAIL=$AWSVPCB_EMAIL"
   echo "AWSVPCB_COURSES=$AWSVPCB_COURSES"
   echo "AWSVPCB_SUPPORT=$AWSVPCB_SUPPORT"
   echo "AWSVPCB_REGISTRY_ADD=$AWSVPCB_REGISTRY_ADD"
   echo
   read -p "IS THIS CORRECT [Y]? (Y/N): " answer
   if [ "$answer" == "n" -o "$answer" == "N" ]; then continue
   else break
   fi
done


# Save updated settings to the professor's S3 bucket
echo
echo $(date) "Saving answers in your S3 bucket" | tee -a awsvpcb-setup.log
echo "export AWSVPCB_INSTITUTION=\"$AWSVPCB_INSTITUTION\"" > S3settings.temp
echo "export AWSVPCB_PROFESSOR=\"$AWSVPCB_PROFESSOR\"" >> S3settings.temp
echo "export AWSVPCB_EMAIL=$AWSVPCB_EMAIL" >> S3settings.temp
echo "export AWSVPCB_SUPPORT=$AWSVPCB_SUPPORT" >> S3settings.temp
echo "export AWSVPCB_COURSES=\"$AWSVPCB_COURSES\"" >> S3settings.temp
echo "export AWSVPCB_REGISTRY_ADD=$AWSVPCB_REGISTRY_ADD" >> S3settings.temp
echo $(date) "Here are the contents of the S3settings.temp file being uploaded to S3:" >> awsvpcb-setup.log
cat S3settings.temp >> awsvpcb-setup.log
aws s3api put-object --bucket $BUCKET --key SetupSettings --body S3settings.temp >> awsvpcb-setup.log 2>&1
rm -f S3settings.temp


# Check to see if SNS topic Diaglog-notification exists; if so, then recreate?  If not, then create
SNS_Create=1
SNS_Arn=`aws sns list-topics --region $REGION --query "Topics[?ends_with(TopicArn,':Diaglog-notification')].TopicArn" --output text 2>> awsvpcb-setup.log`
if [ "$SNS_Arn" != "" -a "$SNS_Arn" != "None" ]; then
   echo $(date) "Found existing Diaglog-notification topic, prompting to see if it should be retained..." >> awsvpcb-setup.log
   read -p "Found existing Diaglog-notification topic, do you want to retain it [Y]? (Y/N): " answer
   if [ "$answer" == "n" -o "$answer" == "N" ]; then
      echo $(date) "Removing existing Diaglog-notification topic..." | tee -a awsvpcb-setup.log
      aws sns delete-topic --topic-arn $SNS_Arn --region $REGION >> awsvpcb-setup.log 2>&1
   else
      echo $(date) "Keeping existing Diaglog-notification topic - moving on..." | tee -a awsvpcb-setup.log
      SNS_Create=0
   fi
fi
if [ $SNS_Create == 1 ]; then
   echo $(date) "Creating new Diaglog-notification topic..." | tee -a awsvpcb-setup.log
   SNS_Arn=`aws sns create-topic --name Diaglog-notification --region $REGION --query TopicArn --output text 2>> awsvpcb-setup.log`
   if [ "$SNS_Arn" == "" -o "$SNS_Arn" == "None" ]; then
      echo $(date) "Unable to create the Diaglog-notification SNS topic - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
   echo $(date) "Creating new email subscription to $SNS_Arn for $AWSVPCB_EMAIL..." | tee -a awsvpcb-setup.log
   aws sns subscribe --topic-arn $SNS_Arn --protocol email --notification-endpoint $AWSVPCB_EMAIL --region $REGION >> awsvpcb-setup.log 2>&1
   echo $(date) "PLEASE GO TO YOUR EMAIL TO CONFIRM THE NEW SUBSCRIPTION - PRESS ANY KEY TO CONTINUE..." | tee -a awsvpcb-setup.log
   read -n 1 -s -r
fi
echo $(date) "The SNS topic in use is $SNS_Arn" >> awsvpcb-setup.log


# Check if custom policy LambdaSNSTopicDest exists; if so, then move on, else create
POL_Arn=arn:aws:iam::$AWS_UID:policy/LambdaSNSTopicDest
aws iam get-policy --policy-arn $POL_Arn > /dev/null 2>&1
if [ $? -eq 0 ]; then
   echo $(date) "Found existing LambdaSNSTopicDest policy - moving on..." | tee -a awsvpcb-setup.log
else
   echo $(date) "Creating new LambdaSNSTopicDest policy..." | tee -a awsvpcb-setup.log
   cat <<EOF > "LambdaSNSTopicDestPolicy.json"
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "$SNS_Arn"
        }
    ]
}
EOF
   aws iam create-policy --policy-name LambdaSNSTopicDest --policy-document file://LambdaSNSTopicDestPolicy.json >> awsvpcb-setup.log 2>&1
   rm -f LambdaSNSTopicDestPolicy.json
   aws iam get-policy --policy-arn $POL_Arn > /dev/null 2>&1
   if [ $? -ne 0 ]; then
      echo $(date) "Unable to create the LambdaSNSTopicDest policy - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
fi


# Check if custom role S3LambdaRole exists; if so, then move on, else create
ROL_Arn=arn:aws:iam::$AWS_UID:role/S3LambdaRole
ROLE_IS_NEW=0
aws iam get-role --role-name S3LambdaRole > /dev/null 2>&1
if [ $? -ne 0 ]; then
   echo $(date) "Creating S3LambdaRole Role..." | tee -a awsvpcb-setup.log
   cat <<EOF > "S3LambdaRole.json"
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF
   aws iam create-role --role-name S3LambdaRole --assume-role-policy-document file://S3LambdaRole.json >> awsvpcb-setup.log 2>&1
   rm -f S3LambdaRole.json
   ROLE_IS_NEW=1
   aws iam get-role --role-name S3LambdaRole > /dev/null 2>&1
   if [ $? -ne 0 ]; then
      echo $(date) "Unable to create the S3LambdaRole role - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
      bail_out
   fi
else
   echo $(date) "The S3LambdaRole Role exists - moving on..." | tee -a awsvpcb-setup.log
fi
echo $(date) "Attaching policies to the S3LambdaRole role..." | tee -a awsvpcb-setup.log
aws iam attach-role-policy --role-name S3LambdaRole --policy-arn "$POL_Arn" >> awsvpcb-setup.log 2>&1
aws iam attach-role-policy --role-name S3LambdaRole --policy-arn arn:aws:iam::aws:policy/AmazonS3FullAccess >> awsvpcb-setup.log 2>&1
aws iam attach-role-policy --role-name S3LambdaRole --policy-arn arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole >> awsvpcb-setup.log 2>&1
if [ $ROLE_IS_NEW -eq 1 ]; then
   echo $(date) "Waiting 15 seconds for the new IAM role to propagate before creating Lambda functions..." | tee -a awsvpcb-setup.log
   sleep 15
fi


# Create the CloudWatch log groups for the two DIAGLOG Lambda functions.  Lambda
# creates these on first invocation, but creating them here means they exist (and
# have a retention period) before the first student ever runs AWSVPCB.DIAGLOG.
for LOGGRP in /aws/lambda/DIAGLOG-TRIGGER /aws/lambda/DIAGLOG-UPLOAD; do
   aws logs describe-log-groups --log-group-name-prefix $LOGGRP --region $REGION --query "logGroups[?logGroupName=='$LOGGRP'].logGroupName" --output text > LOGout.temp 2>> awsvpcb-setup.log
   if [ -s LOGout.temp ]; then
      echo $(date) "CloudWatch log group $LOGGRP already exists - moving on..." | tee -a awsvpcb-setup.log
   else
      echo $(date) "Creating CloudWatch log group $LOGGRP..." | tee -a awsvpcb-setup.log
      aws logs create-log-group --log-group-name $LOGGRP --region $REGION >> awsvpcb-setup.log 2>&1
   fi
   aws logs put-retention-policy --log-group-name $LOGGRP --retention-in-days 30 --region $REGION >> awsvpcb-setup.log 2>&1
done
rm -f LOGout.temp


# Check if the DIAGLOG-TRIGGER Lambda function exists; if so, move on, else create
aws lambda get-function --function-name DIAGLOG-TRIGGER --region $REGION > /dev/null 2>&1
if [ $? -ne 0 ]; then
   echo $(date) "Creating DIAGLOG-TRIGGER Lambda Function..." | tee -a awsvpcb-setup.log
   cat <<EOF > "lambda_function.py"
import json

def lambda_handler(event, context):
    # TODO implement
    return  'DETECTED DIAGLOG ENTRY CREATED!'
EOF
   zip -q DIAGLOG-TRIGGER.zip lambda_function.py
   ATTEMPT=1
   while [ $ATTEMPT -le 6 ]; do
      aws lambda create-function --function-name DIAGLOG-TRIGGER --runtime python3.12 --role $ROL_Arn --handler lambda_function.lambda_handler --region $REGION --zip-file fileb://DIAGLOG-TRIGGER.zip >> awsvpcb-setup.log 2>&1
      if [ $? -eq 0 ]; then break; fi
      echo $(date) "Lambda creation attempt $ATTEMPT failed (the new IAM role may not have propagated yet) - retrying in 10 seconds..." | tee -a awsvpcb-setup.log
      sleep 10
      ATTEMPT=`expr $ATTEMPT + 1`
   done
   rm -f DIAGLOG-TRIGGER.zip lambda_function.py
else
   echo $(date) "The DIAGLOG-TRIGGER Lambda function already exists - moving on..." | tee -a awsvpcb-setup.log
fi
TRG_Arn=`aws lambda get-function --function-name DIAGLOG-TRIGGER --region $REGION --query Configuration.FunctionArn --output text 2>> awsvpcb-setup.log`
if [ "$TRG_Arn" == "" -o "$TRG_Arn" == "None" ]; then
   echo $(date) "Unable to create the DIAGLOG-TRIGGER Lambda function - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
   bail_out
fi
aws lambda put-function-event-invoke-config --function-name DIAGLOG-TRIGGER --region $REGION --destination-config '{"OnSuccess": {"Destination": "'$SNS_Arn'"}}' >> awsvpcb-setup.log 2>&1


# Check to see if S3 Bucket permissions exist; if so, move on, else create
aws lambda get-policy --function-name DIAGLOG-TRIGGER --region $REGION > /dev/null 2>&1
if [ $? -ne 0 ]; then
   echo $(date) "Adding permissions to allow S3 bucket to trigger the DIAGLOG-TRIGGER Lambda Function..." | tee -a awsvpcb-setup.log
   aws lambda add-permission --function-name DIAGLOG-TRIGGER --statement-id "S3InvokePermission" --action "lambda:InvokeFunction" --principal "s3.amazonaws.com" --source-account "$AWS_UID" --source-arn "arn:aws:s3:::$BUCKET" --region $REGION >> awsvpcb-setup.log 2>&1
else
   echo $(date) "Permissions already exist to allow S3 bucket to trigger the DIAGLOG-TRIGGER Lambda Function - moving on..." | tee -a awsvpcb-setup.log
fi

# The student DIAGLOG uploads land under SEMESTER/student/timestamp/vpcb-config,
# so the notification can only filter on the SUFFIX.  A Prefix rule of
# "vpcb-config" would never match a student upload.
echo $(date) "Configuring the S3 event notification on $BUCKET..." | tee -a awsvpcb-setup.log
cat <<EOF > "S3BucketNotificationConfig.json"
{
  "LambdaFunctionConfigurations": [
    {
      "Id": "DIAGLOG-TRIGGER-$AWS_UID",
      "LambdaFunctionArn": "$TRG_Arn",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "Suffix",
              "Value": "vpcb-config"
            }
          ]
        }
      }
    }
  ]
}
EOF
aws s3api put-bucket-notification-configuration --bucket $BUCKET --notification-configuration file://S3BucketNotificationConfig.json >> awsvpcb-setup.log 2>&1
rm -f S3BucketNotificationConfig.json


# Check if the DIAGLOG-UPLOAD Lambda function exists; if so, move on, else create
aws lambda get-function --function-name DIAGLOG-UPLOAD --region $REGION > /dev/null 2>&1
if [ $? -ne 0 ]; then
   echo $(date) "Creating DIAGLOG-UPLOAD Lambda Function..." | tee -a awsvpcb-setup.log
   cat <<EOF > "lambda_function.py"
import json
import boto3
from botocore.config import Config

def lambda_handler(event, context):
    key = event["queryStringParameters"]['filename']
    bucket_name = '$BUCKET'
    s3_client = boto3.client('s3', config=Config(signature_version='s3v4'))
    response = s3_client.generate_presigned_url('put_object', Params={'Bucket': bucket_name, 'Key': key}, ExpiresIn=60)
    return {
        'statusCode': 200,
        'body': json.dumps(response)
    }
EOF
   zip -q DIAGLOG-UPLOAD.zip lambda_function.py
   ATTEMPT=1
   while [ $ATTEMPT -le 6 ]; do
      aws lambda create-function --function-name DIAGLOG-UPLOAD --runtime python3.12 --role $ROL_Arn --handler lambda_function.lambda_handler --region $REGION --zip-file fileb://DIAGLOG-UPLOAD.zip >> awsvpcb-setup.log 2>&1
      if [ $? -eq 0 ]; then break; fi
      echo $(date) "Lambda creation attempt $ATTEMPT failed (the new IAM role may not have propagated yet) - retrying in 10 seconds..." | tee -a awsvpcb-setup.log
      sleep 10
      ATTEMPT=`expr $ATTEMPT + 1`
   done
   rm -f DIAGLOG-UPLOAD.zip lambda_function.py
else
   echo $(date) "The DIAGLOG-UPLOAD Lambda function already exists - moving on..." | tee -a awsvpcb-setup.log
fi
UPL_Arn=`aws lambda get-function --function-name DIAGLOG-UPLOAD --region $REGION --query Configuration.FunctionArn --output text 2>> awsvpcb-setup.log`
if [ "$UPL_Arn" == "" -o "$UPL_Arn" == "None" ]; then
   echo $(date) "Unable to create the DIAGLOG-UPLOAD Lambda function - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
   bail_out
fi


# Checking to see if the Lambda function DIAGLOG-UPLOAD already has a URL; if so
# make sure it is still set to public (AuthType NONE); if not, create it that way.
aws lambda get-function-url-config --function-name DIAGLOG-UPLOAD --region $REGION > /dev/null 2>&1
if [ $? -ne 0 ]; then
   echo $(date) "Creating Function URL for the DIAGLOG-UPLOAD Lambda Function..." | tee -a awsvpcb-setup.log
   aws lambda create-function-url-config --function-name DIAGLOG-UPLOAD --auth-type NONE --region $REGION >> awsvpcb-setup.log 2>&1
else
   echo $(date) "The DIAGLOG-UPLOAD Lambda function already has a Function URL - checking its authorization type..." | tee -a awsvpcb-setup.log
   URL_AUTH=`aws lambda get-function-url-config --function-name DIAGLOG-UPLOAD --region $REGION --query AuthType --output text 2>> awsvpcb-setup.log`
   if [ "$URL_AUTH" != "NONE" ]; then
      echo $(date) "The Function URL was set to $URL_AUTH which blocks the students - changing it to NONE..." | tee -a awsvpcb-setup.log
      aws lambda update-function-url-config --function-name DIAGLOG-UPLOAD --auth-type NONE --region $REGION >> awsvpcb-setup.log 2>&1
   else
      echo $(date) "The Function URL is already set to NONE - moving on..." | tee -a awsvpcb-setup.log
   fi
fi
URL_Arn=`aws lambda get-function-url-config --function-name DIAGLOG-UPLOAD --region $REGION --query FunctionUrl --output text 2>> awsvpcb-setup.log`
URL_AUTH=`aws lambda get-function-url-config --function-name DIAGLOG-UPLOAD --region $REGION --query AuthType --output text 2>> awsvpcb-setup.log`
if [ "$URL_Arn" == "" -o "$URL_Arn" == "None" ]; then
   echo $(date) "Unable to create the Function URL for DIAGLOG-UPLOAD - ending script - contact nmonfort@fiu.edu for help" | tee -a awsvpcb-setup.log
   bail_out
fi
# AWS returns the Function URL with a trailing slash and the student scripts append
# their own, which produces a // in the request path - strip it here.
URL_Arn="${URL_Arn%/}"
echo $(date) "The Function URL is $URL_Arn with AuthType $URL_AUTH" | tee -a awsvpcb-setup.log


# Make sure the Function URL grants anonymous access.  This is re-applied on every
# run because a missing permission is exactly what makes the students' DIAGLOG fail
# with 403 Forbidden, and add-permission is harmless when the statement is present.
echo $(date) "Making sure the DIAGLOG-UPLOAD Function URL allows public invocation..." | tee -a awsvpcb-setup.log
aws lambda add-permission --function-name DIAGLOG-UPLOAD --statement-id "FunctionURLAllowPublicAccess" --action "lambda:InvokeFunctionUrl" --principal "*" --function-url-auth-type NONE --region $REGION >> awsvpcb-setup.log 2>&1
echo $(date) "The DIAGLOG-UPLOAD resource policy is currently:" >> awsvpcb-setup.log
aws lambda get-policy --function-name DIAGLOG-UPLOAD --region $REGION --query Policy --output text >> awsvpcb-setup.log 2>&1
echo >> awsvpcb-setup.log


# END TO END TEST - ask the Function URL for a presigned URL and then upload a file
# with it, exactly the way procs/awsvpcb.diaglog.logfile does on the student side.
# The live test is the only trustworthy check - a statement can be present in the
# policy and still not grant access - so never judge this from the policy text.
run_upload_test () {
   rm -f presignedURL curlput.temp
   echo "AWSVPCB setup verification $(date)" > setup-verify.temp
   TEST_TS=`date +%s`
   HTTP_CODE=`curl --silent --output presignedURL --write-out "%{http_code}" "$URL_Arn/?filename=setup-verification%2F$TEST_TS%2Fsetup-verify.txt"`
   echo $(date) "The Function URL returned HTTP $HTTP_CODE" | tee -a awsvpcb-setup.log
   TEST_URL=`cat presignedURL | sed 's/^.//' | sed 's/.$//'`
   UPLOAD_OK=0
   if [ "$HTTP_CODE" == "200" -a "$TEST_URL" != "" ]; then
      PUT_CODE=`curl --silent --output curlput.temp --write-out "%{http_code}" -X PUT -H "Content-type : multipart/form-data" --data-binary "@setup-verify.temp" $TEST_URL`
      echo $(date) "The presigned S3 upload returned HTTP $PUT_CODE" | tee -a awsvpcb-setup.log
      cat curlput.temp >> awsvpcb-setup.log
      if [ "$PUT_CODE" == "200" ]; then UPLOAD_OK=1; fi
   else
      echo $(date) "The Function URL did not return a presigned URL - here is what came back:" | tee -a awsvpcb-setup.log
      cat presignedURL | tee -a awsvpcb-setup.log
      echo | tee -a awsvpcb-setup.log
   fi
   rm -f presignedURL setup-verify.temp curlput.temp
}

echo $(date) "Testing the DIAGLOG upload end to end..." | tee -a awsvpcb-setup.log
run_upload_test

# A 403 while the Function URL is set to NONE means the statement that is supposed
# to allow anonymous callers is present but not effective.  That happens when the
# statement was first created while the URL was AWS_IAM: add-permission stamps the
# lambda:FunctionUrlAuthType condition into the statement when it is created,
# changing the URL afterwards does not rewrite it, and add-permission refuses to
# touch a statement id that already exists (ResourceConflictException).  Adding a
# second, correctly conditioned statement under a new id fixes it - any matching
# Allow in the policy is enough - and it leaves the old statement alone.
if [ $UPLOAD_OK -eq 0 -a "$HTTP_CODE" == "403" ]; then
   echo $(date) "The endpoint returned 403 even though the Function URL AuthType is NONE." | tee -a awsvpcb-setup.log
   echo $(date) "Adding a corrected public invoke statement (FunctionURLAllowPublicAccessV2)..." | tee -a awsvpcb-setup.log
   aws lambda add-permission --function-name DIAGLOG-UPLOAD --statement-id "FunctionURLAllowPublicAccessV2" --action "lambda:InvokeFunctionUrl" --principal "*" --function-url-auth-type NONE --region $REGION >> awsvpcb-setup.log 2>&1
   echo $(date) "The DIAGLOG-UPLOAD resource policy is now:" >> awsvpcb-setup.log
   aws lambda get-policy --function-name DIAGLOG-UPLOAD --region $REGION --query Policy --output text >> awsvpcb-setup.log 2>&1
   echo >> awsvpcb-setup.log
   echo $(date) "Re-testing the DIAGLOG upload end to end..." | tee -a awsvpcb-setup.log
   run_upload_test
fi

if [ $UPLOAD_OK -eq 1 ]; then
   echo $(date) "DIAGLOG UPLOAD TEST PASSED - students will be able to send you their logs." | tee -a awsvpcb-setup.log
else
   echo $(date) "*** DIAGLOG UPLOAD TEST FAILED ***" | tee -a awsvpcb-setup.log
   echo $(date) "    Your students AWSVPCB.DIAGLOG will not reach your S3 bucket." | tee -a awsvpcb-setup.log
   echo $(date) "    The Function URL is $URL_Arn with AuthType $URL_AUTH." | tee -a awsvpcb-setup.log
   echo $(date) "    The full resource policy has been written to awsvpcb-setup.log above." | tee -a awsvpcb-setup.log
   echo $(date) "    If the policy looks correct, check whether an AWS Organizations service" | tee -a awsvpcb-setup.log
   echo $(date) "    control policy or resource control policy is blocking anonymous access." | tee -a awsvpcb-setup.log
   echo $(date) "    The setup will finish, but please send awsvpcb-setup.log to nmonfort@fiu.edu." | tee -a awsvpcb-setup.log
fi


# Create new vpcb-config file and upload to professor's S3 bucket & centralized S3 bucket
INSTITUTION_MODIFIED="${AWSVPCB_INSTITUTION// /_}"
PROFESSOR_MODIFIED="${AWSVPCB_PROFESSOR// /_}"
